<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net11.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsAotCompatible>true</IsAotCompatible>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<LangVersion>preview</LangVersion>

		<!-- Nuget -->
		<PackageId>Henke.Hengine.Utils</PackageId>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MinVer" Version="6.0.0">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
		</PackageReference>
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- Local-deps source switch: see Directory.Build.props / local.props.example -->
  <ItemGroup Condition="'$(UseLocalProjects)' != 'true'">
		<PackageReference Include="Henke.EnCS" Version="0.0.108" />
		<PackageReference Include="Henke.MathLib" Version="0.0.26" />
		<PackageReference Include="Henke.UtilLib" Version="0.0.37" />
  </ItemGroup>
  <ItemGroup Condition="'$(UseLocalProjects)' == 'true'">
		<ProjectReference Include="..\..\EnCS\EnCS\EnCS.csproj" />
		<ProjectReference Include="..\..\MathLib\MathLib\MathLib.csproj" />
		<ProjectReference Include="..\..\UtilLib\UtilLib\UtilLib.csproj" />
  </ItemGroup>

</Project>
